# Copiar a .env y completar DB_PASSWORD manualmente.
# No se incluye ninguna contraseña real en este archivo.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=job_board_db

# Habilitar TLS para PostgreSQL remoto (por ejemplo Neon).
# Mantener false con PostgreSQL local. Valores válidos: true o false.
DB_SSL=false

# Los tests SOLO pueden conectarse a esta base.
TEST_DB_NAME=job_board_db_test

# Secreto para firmar JWT. Completar manualmente.
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma. Sin comodines ni rutas.
# En producción, reemplazar o ampliar con los orígenes reales del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173
